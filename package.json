{
  "name": "firebase-web-app",
  "version": "1.0.0",
  "description": "Firebase web application",
  "main": "public/index.html",
  "scripts": {
    "dev": "npx http-server public -p 5000 -c-1",
    "dev:firebase": "firebase serve --only hosting --port 5000",
    "build": "echo 'No build step required for static files'",
    "start": "npx http-server public -p 8080",
    "deploy": "firebase deploy --only hosting",
    "lint": "echo 'Linting not configured'",
    "serve": "firebase serve"
  },
  "dependencies": {
    "firebase": "^11.1.0"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "http-server": "^14.1.1"
  },
  "keywords": [
    "firebase",
    "web",
    "hosting"
  ]
}
